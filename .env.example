# Copy this file to .env (same folder) and fill in your key. .env is git-ignored; never commit it.
OPENAI_API_KEY=
# Optional: defaults to gpt-4.1-mini
# OPENAI_MODEL=gpt-4.1-mini

# Stripe sandbox (test mode only): Dashboard -> Developers -> API keys -> Secret key (sk_test_...)
STRIPE_SECRET_KEY=

# Alerts (python -m finance_os.alerts, run by the morning job). Configure any channel; with none, the digest
# goes to data/live/alerts_outbox.md and nothing is sent.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# ALERT_EMAIL_FROM=
# ALERT_EMAIL_TO=
# APP_URL=http://localhost:5173
